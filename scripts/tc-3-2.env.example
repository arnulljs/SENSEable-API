# TC-3.2 settings. Copy to .env.tc32 in the senseable-api folder (ignored by git) and fill in.
# Leave a half's settings blank to skip that half.

# Both halves: the org the test account belongs to, and another org to probe.
TC_A_SLUG=aquatech
TC_B_SLUG=llba

# API half (the deployed app)
TC_API_BASE=https://senseable-iot.vercel.app
TC_SUPABASE_URL=            # same as VITE_SUPABASE_URL
TC_SUPABASE_ANON=           # same as VITE_SUPABASE_PUBLISHABLE_KEY
TC_A_EMAIL=                 # active member of TC_A_SLUG
TC_A_PASSWORD=
# Optional: a confirmed account that belongs to no organization (expects 403)
TC_NOORG_EMAIL=
TC_NOORG_PASSWORD=

# RLS half: the app role's connection string (Vercel's CLOUD_DATABASE_URL_POOLED,
# user senseable_app). NOT the owner or postgres login: those bypass RLS and
# the script refuses to run as them.
TC_APP_DB_URL=
