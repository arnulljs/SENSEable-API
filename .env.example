# Copy to .env to override defaults. The HTTP server works with NONE of these
# set (broker-free); MQTT_URL is only needed for a live broker.

# ── HTTP ─────────────────────────────────────────────────────────────────────
PORT=4000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# app role (RLS-enforced, per-request writes) and owner role (RLS-exempt, boot
# hydration + migrations/seed).
DATABASE_URL=postgres://senseable_app:CHANGEME@localhost:5432/senseable
DATABASE_URL_OWNER=postgres://senseable_owner:CHANGEME@localhost:5432/senseable

# ── Staleness / history tuning (ms unless noted) ─────────────────────────────
STALE_MS=30000        # no telemetry for this long -> node/port goes Offline
SWEEP_MS=5000         # how often the server re-evaluates staleness
HISTORY_CAP=40        # max points kept per port history
COMMAND_CAP=100       # max recent commands kept in the cmd/ack log

# ── Status-code interpretation ───────────────────────────────────────────────
# 'schema'  = the frozen Payload-Schemas codes (0 NORMAL, 1 OPEN, 2 FAULT_OOR,
#             3 HARDWARE_OFFLINE) — the default, matches current firmware.
# 'legacy'  = the old wide dictionary (SYS_NORMAL/CELLULAR_ACTIVE/...). Only for
#             historical payloads; do NOT use with current hardware.
STATUS_PROFILE=schema

# Reject telemetry whose `tid` isn't mapped in tenants.mqtt_tid (prevents a node
# claiming "N001" from writing into another tenant). Leave on except on a
# single-tenant bring-up bench.
INGEST_STRICT_TENANT=true

# ── Live MQTT ingest + command publishing (optional) ─────────────────────────
# Leave MQTT_URL unset to run broker-free (HTTP ingest/command endpoints only).
# Topic namespace is the frozen one: usc/thesis/{tid}/{nid}/{tlm,disco,cmd,ack}.
#
# Local Mosquitto (current bench, from SENSEable-HW/MQTT Debug):
#   MQTT_URL=mqtts://10.136.54.162:8883
#   MQTT_USERNAME=admin_user
#   MQTT_PASSWORD=adminpass1234
#   MQTT_CA_CERT=/path/to/ca.crt
#   MQTT_TLS_INSECURE=true          # bench only: skip hostname/chain checks
#
# HiveMQ Cloud:
#   MQTT_URL=mqtts://your-cluster.hivemq.cloud:8883
#   MQTT_USERNAME=
#   MQTT_PASSWORD=
#   MQTT_CA_CERT=/path/to/isrg-root-x1.pem
#
# MQTT_TOPIC_BASE=usc/thesis        # override the topic root if it ever changes
# MQTT_TID=+                        # subscribe filter: '+' = any tenant
# MQTT_NID=+                        # subscribe filter: '+' = any node
# MQTT_CLIENT_ID=senseable-backend
# Copy to .env to override defaults. The HTTP server works with NONE of these
# set (broker-free); MQTT_URL is only needed for a live broker.

# ── HTTP ─────────────────────────────────────────────────────────────────────
PORT=4000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# app role (RLS-enforced, per-request writes) and owner role (RLS-exempt, boot
# hydration + migrations/seed).
DATABASE_URL=postgres://senseable_app:CHANGEME@localhost:5432/senseable
DATABASE_URL_OWNER=postgres://senseable_owner:CHANGEME@localhost:5432/senseable

# ── Staleness / history tuning (ms unless noted) ─────────────────────────────
STALE_MS=30000        # no telemetry for this long -> node/port goes Offline
SWEEP_MS=5000         # how often the server re-evaluates staleness
HISTORY_CAP=40        # max points kept per port history
COMMAND_CAP=100       # max recent commands kept in the cmd/ack log

# ── Status-code interpretation ───────────────────────────────────────────────
# 'schema'  = the frozen Payload-Schemas codes (0 NORMAL, 1 OPEN, 2 FAULT_OOR,
#             3 HARDWARE_OFFLINE) — the default, matches current firmware.
# 'legacy'  = the old wide dictionary (SYS_NORMAL/CELLULAR_ACTIVE/...). Only for
#             historical payloads; do NOT use with current hardware.
STATUS_PROFILE=schema

# Reject telemetry whose `tid` isn't mapped in tenants.mqtt_tid (prevents a node
# claiming "N001" from writing into another tenant). Leave on except on a
# single-tenant bring-up bench.
INGEST_STRICT_TENANT=true

# ── Live MQTT ingest + command publishing (optional) ─────────────────────────
# Leave MQTT_URL unset to run broker-free (HTTP ingest/command endpoints only).
# Topic namespace is the frozen one: usc/thesis/{tid}/{nid}/{tlm,disco,cmd,ack}.
#
# Local Mosquitto (current bench, from SENSEable-HW/MQTT Debug):
#   MQTT_URL=mqtts://10.136.54.162:8883
#   MQTT_USERNAME=admin_user
#   MQTT_PASSWORD=adminpass1234
#   MQTT_CA_CERT=/path/to/ca.crt
#   MQTT_TLS_INSECURE=true          # bench only: skip hostname/chain checks
#
# HiveMQ Cloud:
#   MQTT_URL=mqtts://your-cluster.hivemq.cloud:8883
#   MQTT_USERNAME=
#   MQTT_PASSWORD=
#   MQTT_CA_CERT=/path/to/isrg-root-x1.pem
#
# MQTT_TOPIC_BASE=usc/thesis        # override the topic root if it ever changes
# MQTT_TID=+                        # subscribe filter: '+' = any tenant
# MQTT_NID=+                        # subscribe filter: '+' = any node
# MQTT_CLIENT_ID=senseable-backend

# ── Security ────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call this API from a browser. Defaults to
# localhost:5173 only. A bare cors() would let ANY website read this API using
# the visitor's network position — on a LAN device that is a real exposure.
CORS_ORIGINS=http://localhost:5173

# Shared secret required in the x-api-key header. Leave UNSET for bench work;
# set it for any deployment reachable beyond localhost. This authenticates the
# CALLER, not the user — per-user authorisation is future work.
# API_KEY=

# Requests per minute per source address. Reads are generous (dashboard polling
# plus several tabs); writes are tighter; commands are tightest because each one
# actuates physical hardware.
RATE_LIMIT_READ=600
RATE_LIMIT_WRITE=60
RATE_LIMIT_COMMAND=30

# Number of proxy hops in front of this server, so req.ip is the real client.
# 0 when reached directly; 1 behind a single reverse proxy.
TRUST_PROXY=0
