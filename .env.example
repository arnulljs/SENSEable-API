# Copy to .env to override defaults. Everything works with NONE of these set.

# HTTP
PORT=4000

# Staleness / history tuning (ms unless noted)
STALE_MS=30000        # no telemetry for this long -> node/port goes Offline
SWEEP_MS=5000         # how often the server re-evaluates staleness
HISTORY_CAP=40        # max points kept per port history

# Status-code interpretation: 'spec' (frozen dictionary) or 'firmware'
# (blink_example_main.c's 0/1/2/3 scheme). Match your actual node output.
STATUS_PROFILE=spec

# OPTIONAL live MQTT ingest. Leave MQTT_URL unset to run broker-free.
# MQTT_URL=mqtts://your-cluster.hivemq.cloud:8883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# APP_ID=t1             # {appId} segment in topic namespace; '+' = any
