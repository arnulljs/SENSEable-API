# scripts/latency-listener.js settings. Copy to .env.latency and fill in. Never commit .env.latency.

# Its own HiveMQ login (read usc/thesis/#, publish commands).
LATENCY_MQTT_URL=mqtts://YOUR-CLUSTER.s1.eu.hivemq.cloud:8883
LATENCY_MQTT_USERNAME=latency-listener
LATENCY_MQTT_PASSWORD=

# Backend hops (Lambda → database → Vercel, and --cmd). Leave blank to measure
# only node → broker and ping.
LATENCY_API_BASE=https://senseable-iot.vercel.app
LATENCY_SUPABASE_URL=            # same as VITE_SUPABASE_URL
LATENCY_SUPABASE_ANON=           # same as VITE_SUPABASE_PUBLISHABLE_KEY
LATENCY_EMAIL=                   # an active member of the nodes' organization
LATENCY_PASSWORD=
