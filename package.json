{
  "name": "senseable-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Barebones backend for SENSEable — ingests raw ADC telemetry (frozen wire protocol), applies calibration, serves the React dashboard's data shape over REST.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "simulate": "node scripts/simulate.js",
    "check": "find src scripts -name '*.js' -exec node --check {} +",
    "sync": "node scripts/sync.js",
    "sync:once": "node scripts/sync.js --once",
    "sync:status": "node scripts/sync.js --status",
    "sync:backfill": "node scripts/sync.js --backfill",
    "migrate:cloud": "node-pg-migrate -m db/migrations --envPath .env.cloud --database-url-var CLOUD_DATABASE_URL_OWNER_SESSION",
    "migrate": "node-pg-migrate -m db/migrations --envPath .env --database-url-var DATABASE_URL_OWNER",
    "test:realtime": "node scripts/test-realtime.js",
    "test:cloudfirst": "bash scripts/run-cloudfirst-tests.sh",
    "test:dispatch": "node scripts/test-dispatch.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "mathjs": "^15.2.0",
    "mqtt": "^5.10.3",
    "pg": "^8.22.0",
    "ws": "^8.21.3"
  }
}
