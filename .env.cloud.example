# .env.cloud.example — Supabase (cloud tier) connection settings.
# Copy to .env.cloud. This file is ONLY for the cloud repository: migrations,
# the sync worker, and the Vercel read API. The edge server keeps using .env
# for its LOCAL Postgres, which remains the primary store.
#
# ── WHICH CONNECTION STRING TO USE ──────────────────────────────────────────
# Supabase offers three. They are NOT interchangeable:
#
#   DIRECT      db.<ref>.supabase.co:5432
#               IPv6-only unless you buy the IPv4 add-on. If your network is
#               IPv4-only (most PH home/campus links are), this will simply
#               time out. Prefer session-mode pooler below.
#
#   POOLER, SESSION mode   aws-0-<region>.pooler.supabase.com:5432
#               IPv4. One connection held per client. Use for MIGRATIONS and
#               the SYNC WORKER (long-lived, needs full session semantics).
#
#   POOLER, TRANSACTION mode   aws-0-<region>.pooler.supabase.com:6543
#               IPv4. Connections shared per transaction. Use for the VERCEL
#               serverless read API, where thousands of short invocations would
#               otherwise exhaust the connection limit.
#
# USERNAME FORMAT through the pooler is  <role>.<PROJECT_REF>
#   e.g.  senseable_app.abcdefghijklmnop
# Percent-encode any of @ : / ? # in the password, or the URL parser breaks.

# ── Migrations + sync worker (session pooler, owner role) ────────────────────
CLOUD_DATABASE_URL_OWNER=postgres://senseable_owner.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# ── Sync worker writes (session pooler, app role, RLS-enforced) ──────────────
CLOUD_DATABASE_URL=postgres://senseable_app.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# ── Vercel serverless read API (transaction pooler, app role) ────────────────
# Set this one in the Vercel dashboard as an environment variable, not here.
CLOUD_DATABASE_URL_POOLED=postgres://senseable_app.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# ── Sync worker tuning ──────────────────────────────────────────────────────
SYNC_INTERVAL_MS=30000     # how often to push local -> cloud
SYNC_BATCH_SIZE=500        # rows per batch (readings can be high-volume)
SYNC_ENABLED=true          # set false to run the edge server fully offline
